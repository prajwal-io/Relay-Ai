HOST=127.0.0.1
PORT=4317
RELAY_DB_PATH=./data/relay.sqlite
# Optional; kept server-side. Without it, memory and local handoffs still work.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Cloud extraction timeout; local parsing takes over when Groq is slow.
GROQ_TIMEOUT_MS=15000
WEB_ORIGIN=http://localhost:5173
# Add your exact Vercel production URL here when you deploy the frontend.
# Comma-separated; do not use wildcards. Example:
# WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://relay-ai.vercel.app
WEB_ORIGINS=
